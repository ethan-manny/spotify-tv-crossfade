#!/usr/bin/env bash
# Copy to scripts/env.local.sh (git-ignored) and set the values for this machine.
# scripts/env.sh sources it and derives everything else. Anything already exported in the
# environment wins, so use `VAR="${VAR:-...}"` if you want that.

# JDK 21. Optional: without it whatever `java` is on PATH is used.
export JAVA_HOME="/c/Program Files/Android/Android Studio/jbr"

# Android SDK root (build-tools are looked up under it). Native Windows path under Git Bash.
export ANDROID_HOME='C:\path\to\Android\Sdk'

# NDK r27c. Native Windows path under Git Bash.
export ANDROID_NDK_HOME='C:\path\to\Android\Sdk\ndk\android-ndk-r27c'

# adb target: a serial from `adb devices`, or "host:port" for a network device such as a Fire TV
# Stick with adb debugging over the network. Required by the scripts that talk to a device.
export DEVICE=192.168.0.2:5555
